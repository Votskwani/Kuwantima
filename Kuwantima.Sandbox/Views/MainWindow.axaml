<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kuwantima.Sandbox.ViewModels"
        xmlns:conv="using:Kuwantima.Sandbox.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Kuwantima.Sandbox.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Kuwantima Style Sandbox"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <conv:ResourceKeyConverter x:Key="ResourceKey"/>
    </Window.Resources>

    <!--
        Custom window chrome — a worked example kept here in the Sandbox on purpose, not in the
        packaged library. The button visuals are stylable (see the WindowClose override below,
        and MainWindow.axaml.cs for the rest) but minimize/maximize/close are behavior, not a
        selector — the library ships zero C#, and this is exactly the kind of thing that would
        break that. If this ever earns a real README recipe, this is the working reference to
        write it from.

        Avalonia 11's ExtendClientAreaChromeHints="NoChrome" is gone in 12; the replacement is
        WindowDecorations="BorderOnly" (above) plus marking the header below as the title bar
        region (WindowDecorationProperties.ElementRole="TitleBar") — that one attached property
        gives native drag-to-move and double-click-to-maximize for free. "None" instead of
        "BorderOnly" works identically for this demo's purposes.

        TitleBar is a drag region, full stop — it does NOT pass clicks through to children. Every
        pointer press anywhere in that Border, buttons included, is captured as a window-move
        gesture unless the child itself is marked otherwise. Each of the three window-control
        buttons below carries its own WindowDecorationProperties.ElementRole="User" for exactly
        this reason: "User" (as opposed to "DecorationsElement", which is Avalonia's own internal
        chrome) means "app-defined interactive control — pass input through, don't drag." Without
        it the buttons render but silently never fire Click. (There are also OS-native
        CloseButton/MinimizeButton/MaximizeButton roles that hand the action to Win32 directly, but
        that bypasses our own Click handlers and glyph/tooltip state below, so this file uses
        "User" and drives everything from code-behind instead.)

        Known rough edge, verified environmental rather than a bug in this markup: on one test
        machine, maximizing while the window sat on its primary display left a ghost render
        artifact that outlived the window itself (it was still there after the window moved to a
        second monitor) and cleared only on a subsequent restore — reproducible with both
        WindowDecorations values, absent entirely on the secondary display. That rules out
        anything in this file; it's Windows/DWM-level, in the same rough area as several open
        Avalonia 12 issues around ExtendClientAreaToDecorationsHint + maximize
        (AvaloniaUI/Avalonia#21212, #21151, #21318). If a future reader hits something similar,
        it is very unlikely to be their code either — check the primary/secondary display first.
    -->
    <Window.Styles>
        <!-- Windows' own close-hover red, not a Kuwantima palette color — scoped to this window
             only, deliberately not part of the shipped design language. -->
        <Style Selector="Button.WindowClose:pointerover">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="BorderBrush" Value="#C42B1C"/>
        </Style>
        <Style Selector="Button.WindowClose:pointerover PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Press glow: minimize/maximize reuse the library's own warm accent glow
             (KuwantimaAccentGlowPressed — same resource Button.Kuwantima.Accent presses into) so
             they read as Kuwantima chrome. Close gets a red-tinted echo of that same shape instead,
             keeping it out of the shared palette for the reason above. -->
        <Style Selector="Button.WindowControl:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource KuwantimaAccentGlowPressed}"/>
        </Style>
        <Style Selector="Button.WindowClose:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 0 8 2 #70C42B1C, 0 0 18 5 #40C42B1C"/>
        </Style>
    </Window.Styles>

    <!-- Root glass container -->
    <Border Classes="KuwantimaGlass" Margin="8" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

            <!-- HEADER — doubles as the title bar via ElementRole="TitleBar": dragging it moves the
                 window and double-clicking toggles maximize, both native, no code-behind needed. -->
            <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource KuwantimaGlassBackground}"
                    WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="Auto,8,Auto,8,Auto,12,*,12,Auto">
                    <!-- Pane toggle -->
                    <Button Classes="Kuwantima Minimal"
                            WindowDecorationProperties.ElementRole="User"
                            Command="{Binding TogglePaneCommand}"
                            ToolTip.Tip="Toggle navigation pane"
                            Width="36" Height="36">
                        <PathIcon Data="{StaticResource Icon.Sliders}" Width="16" Height="16"/>
                    </Button>

                    <!-- Theme toggle -->
                    <ToggleButton Grid.Column="2" Classes="KuwantimaMenu"
                                  WindowDecorationProperties.ElementRole="User"
                                  Content="Theme"
                                  IsChecked="{Binding IsDarkTheme}"
                                  ToolTip.Tip="Toggle light/dark theme">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton">
                                <Setter Property="Tag" Value="{DynamicResource Icon.Sun}"/>
                            </Style>
                            <Style Selector="ToggleButton:checked">
                                <Setter Property="Tag" Value="{DynamicResource Icon.Moon.ThirdEye.Smiling}"/>
                            </Style>
                        </ToggleButton.Styles>
                    </ToggleButton>

                    <!-- Color palette picker — lands right of the theme toggle, same 48x48 footprint -->
                    <Button Grid.Column="4" Classes="KuwantimaPalette"
                            WindowDecorationProperties.ElementRole="User"
                            ToolTip.Tip="Choose an accent color">
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="KuwantimaPalette" Placement="Bottom">
                                <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto"
                                      RowSpacing="8" ColumnSpacing="8">
                                    <ToggleButton Classes="KuwantimaSwatch" Grid.Row="0" Grid.Column="0"
                                                  Background="{DynamicResource KuwantimaPaletteBlue}"
                                                  IsChecked="{Binding SelectedAccentColor, Mode=OneWay,
                                                              Converter={x:Static ObjectConverters.Equal},
                                                              ConverterParameter={x:Static vm:AccentColorOption.Blue}}"
                                                  Command="{Binding SetAccentColorCommand}"
                                                  CommandParameter="{x:Static vm:AccentColorOption.Blue}"
                                                  ToolTip.Tip="Blue"/>
                                    <ToggleButton Classes="KuwantimaSwatch" Grid.Row="0" Grid.Column="1"
                                                  Background="{DynamicResource KuwantimaPaletteOrange}"
                                                  IsChecked="{Binding SelectedAccentColor, Mode=OneWay,
                                                              Converter={x:Static ObjectConverters.Equal},
                                                              ConverterParameter={x:Static vm:AccentColorOption.Orange}}"
                                                  Command="{Binding SetAccentColorCommand}"
                                                  CommandParameter="{x:Static vm:AccentColorOption.Orange}"
                                                  ToolTip.Tip="Orange"/>
                                    <ToggleButton Classes="KuwantimaSwatch" Grid.Row="0" Grid.Column="2"
                                                  Background="{DynamicResource KuwantimaPalettePurple}"
                                                  IsChecked="{Binding SelectedAccentColor, Mode=OneWay,
                                                              Converter={x:Static ObjectConverters.Equal},
                                                              ConverterParameter={x:Static vm:AccentColorOption.Purple}}"
                                                  Command="{Binding SetAccentColorCommand}"
                                                  CommandParameter="{x:Static vm:AccentColorOption.Purple}"
                                                  ToolTip.Tip="Purple"/>
                                    <ToggleButton Classes="KuwantimaSwatch" Grid.Row="1" Grid.Column="0"
                                                  Background="{DynamicResource KuwantimaPaletteGreen}"
                                                  IsChecked="{Binding SelectedAccentColor, Mode=OneWay,
                                                              Converter={x:Static ObjectConverters.Equal},
                                                              ConverterParameter={x:Static vm:AccentColorOption.Green}}"
                                                  Command="{Binding SetAccentColorCommand}"
                                                  CommandParameter="{x:Static vm:AccentColorOption.Green}"
                                                  ToolTip.Tip="Green"/>
                                    <ToggleButton Classes="KuwantimaSwatch" Grid.Row="1" Grid.Column="1"
                                                  Background="{DynamicResource KuwantimaPaletteRose}"
                                                  IsChecked="{Binding SelectedAccentColor, Mode=OneWay,
                                                              Converter={x:Static ObjectConverters.Equal},
                                                              ConverterParameter={x:Static vm:AccentColorOption.Rose}}"
                                                  Command="{Binding SetAccentColorCommand}"
                                                  CommandParameter="{x:Static vm:AccentColorOption.Rose}"
                                                  ToolTip.Tip="Rose"/>
                                    <!-- Row 1, Column 2 deliberately empty — room for a 6th color. -->
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock Text="Kuwantima Style Sandbox"
                                   FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding KuwantimaVersion, StringFormat='v{0}'}"
                                   FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>

                    <!-- Custom window controls — replace the native titlebar buttons that
                         ExtendClientAreaToDecorationsHint="True" removes above. (Avalonia 11 had a
                         separate ExtendClientAreaChromeHints for this; 12 dropped it — extending
                         the client area now always means full custom chrome.) -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="Kuwantima Minimal WindowControl" Width="36" Height="36"
                                WindowDecorationProperties.ElementRole="User"
                                ToolTip.Tip="Minimize" Click="OnMinimizeClick">
                            <Rectangle Width="10" Height="1.4"
                                       Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        </Button>
                        <Button x:Name="MaximizeRestoreButton" Classes="Kuwantima Minimal WindowControl" Width="36" Height="36"
                                WindowDecorationProperties.ElementRole="User"
                                ToolTip.Tip="Maximize" Click="OnMaximizeRestoreClick">
                            <Rectangle Width="10" Height="10"
                                       Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                       StrokeThickness="1.3"/>
                        </Button>
                        <Button Classes="Kuwantima Minimal WindowClose" Width="36" Height="36"
                                WindowDecorationProperties.ElementRole="User"
                                ToolTip.Tip="Close" Click="OnCloseClick">
                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SPLITVIEW -->
            <SplitView Grid.Row="1"
                       IsPaneOpen="{Binding IsPaneOpen}"
                       DisplayMode="CompactInline"
                       CompactPaneLength="56"
                       OpenPaneLength="220"
                       PaneBackground="Transparent">

                <!-- NAV — one button per entry in MainWindowViewModel.Pages -->
                <SplitView.Pane>
                    <Border Padding="4,8,4,8">
                        <ItemsControl ItemsSource="{Binding Pages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavPage">
                                    <ToggleButton Classes="KuwantimaMenu"
                                                  Classes.Expanded="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsPaneOpen}"
                                                  Tag="{Binding IconKey, Converter={StaticResource ResourceKey}}"
                                                  Content="{Binding Title}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToCommand}"
                                                  CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </SplitView.Pane>

                <!-- PAGE CONTENT — built on first visit, then kept (see NavPage.View) -->
                <SplitView.Content>
                    <ContentControl Margin="4" Content="{Binding SelectedPage.View}"/>
                </SplitView.Content>
            </SplitView>
        </Grid>
    </Border>
</Window>
