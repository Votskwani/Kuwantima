<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kuwantima.Sandbox.ViewModels"
             x:Class="Kuwantima.Sandbox.Views.Pages.FeedbackPage"
             x:DataType="vm:MainWindowViewModel">

    <Border Classes="KuwantimaGlass" Padding="0" ClipToBounds="True">
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="24" MaxWidth="500">

            <!-- Sliders -->
            <StackPanel Spacing="8">
                <TextBlock Text="Sliders" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Slider Classes="Kuwantima" Value="{Binding SliderValue}" Minimum="0" Maximum="100"/>
                <Slider Classes="Kuwantima" Value="30" Minimum="0" Maximum="100"/>
                <Slider Classes="Kuwantima" Value="75" Minimum="0" Maximum="100" IsEnabled="False"/>
            </StackPanel>

            <!-- Progress Bars -->
            <StackPanel Spacing="8">
                <TextBlock Text="Progress Bars" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <ProgressBar Classes="Kuwantima" Value="{Binding ProgressValue}" Minimum="0" Maximum="100"/>
                <ProgressBar Classes="Kuwantima" Value="80" Minimum="0" Maximum="100"/>
                <ProgressBar Classes="Kuwantima" Value="100" Minimum="0" Maximum="100"/>
                <ProgressBar Classes="Kuwantima" IsIndeterminate="True"/>
                <ProgressBar Classes="Kuwantima" Value="50" IsEnabled="False"/>
            </StackPanel>

            <!-- Expanders -->
            <StackPanel Spacing="8">
                <TextBlock Text="Expanders" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Expander Classes="Kuwantima" Header="Vehicle Details" IsExpanded="True">
                    <StackPanel Spacing="4" Margin="4">
                        <TextBlock Text="ID: VH-2048" FontSize="12"/>
                        <TextBlock Text="Status: Active" FontSize="12"
                                   Foreground="{DynamicResource KuwantimaSuccessTextBrush}"/>
                        <TextBlock Text="Speed: 62 km/h" FontSize="12"/>
                    </StackPanel>
                </Expander>
                <Expander Classes="Kuwantima" Header="Route Info">
                    <TextBlock Text="Eastern corridor — 142km remaining" FontSize="12" Margin="4"/>
                </Expander>
                <Expander Classes="Kuwantima" Header="Disabled" IsEnabled="False">
                    <TextBlock Text="Hidden"/>
                </Expander>
            </StackPanel>

            <!-- Scrim -->
            <StackPanel Spacing="8">
                <TextBlock Text="Scrim" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Button Classes="Kuwantima" Content="Show Blocking Overlay" Command="{Binding ToggleScrimCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <!-- A blocking overlay for a long-running operation (probe, save, any multi-step RPC
         sequence) — KuwantimaScrimBackground/Foreground, added v1.5.0. -->
    <Border Background="{DynamicResource KuwantimaScrimBackground}" IsVisible="{Binding IsScrimVisible}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="240">
            <TextBlock Text="Probing device..." FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource KuwantimaScrimForeground}"/>
            <ProgressBar Classes="Kuwantima" IsIndeterminate="True"/>
            <Button Classes="Kuwantima" Content="Dismiss" HorizontalAlignment="Center"
                    Command="{Binding ToggleScrimCommand}"/>
        </StackPanel>
    </Border>
    </Grid>
    </Border>
</UserControl>
