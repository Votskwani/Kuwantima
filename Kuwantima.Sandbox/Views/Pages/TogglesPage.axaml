<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kuwantima.Sandbox.ViewModels"
             x:Class="Kuwantima.Sandbox.Views.Pages.TogglesPage"
             x:DataType="vm:MainWindowViewModel">

    <Border Classes="KuwantimaGlass" Padding="0" ClipToBounds="True">
    <Grid RowDefinitions="*,Auto,*">

        <!-- ═══ TOP ROW ═══ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*">

            <!-- TOP-LEFT: Toggle Buttons -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Margin="16">
                    <TextBlock Text="Toggle Buttons" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <ToggleButton Classes="Kuwantima" Content="Toggle Off" IsChecked="False"
                                  ToolTip.Tip='&lt;ToggleButton Classes="Kuwantima" Content="Toggle Off"/&gt;'/>
                    <ToggleButton Classes="Kuwantima" Content="Toggle On" IsChecked="{Binding IsToggled}"
                                  ToolTip.Tip='&lt;ToggleButton Classes="Kuwantima" IsChecked="{Binding IsToggled}"/&gt;'/>
                    <ToggleButton Classes="Kuwantima" Content="Disabled" IsEnabled="False"
                                  ToolTip.Tip='&lt;ToggleButton Classes="Kuwantima" IsEnabled="False"/&gt;'/>
                </StackPanel>
            </ScrollViewer>

            <!-- Top vertical arrow splitter -->
            <GridSplitter Classes="Kuwantima Arrow Vertical" Grid.Column="1"/>

            <!-- TOP-RIGHT: Checkboxes -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Margin="16">
                    <TextBlock Text="Checkboxes" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <CheckBox Classes="Kuwantima" Content="Unchecked" IsChecked="False"
                              ToolTip.Tip='&lt;CheckBox Classes="Kuwantima"/&gt;'/>
                    <CheckBox Classes="Kuwantima" Content="Checked" IsChecked="{Binding IsChecked}"
                              ToolTip.Tip='&lt;CheckBox Classes="Kuwantima" IsChecked="{Binding IsOn}"/&gt;'/>
                    <CheckBox Classes="Kuwantima" Content="Indeterminate" IsChecked="{x:Null}" IsThreeState="True"
                              ToolTip.Tip='&lt;CheckBox Classes="Kuwantima" IsThreeState="True"/&gt;'/>
                    <CheckBox Classes="Kuwantima" Content="Disabled" IsEnabled="False"
                              ToolTip.Tip='&lt;CheckBox Classes="Kuwantima" IsEnabled="False"/&gt;'/>

                    <TextBlock Text="Classic Checkboxes" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <CheckBox Classes="Kuwantima Classic" Content="Unchecked" IsChecked="False"
                              ToolTip.Tip='&lt;CheckBox Classes="Kuwantima Classic"/&gt;'/>
                    <CheckBox Classes="Kuwantima Classic" Content="Checked" IsChecked="{Binding IsChecked}"
                              ToolTip.Tip='&lt;CheckBox Classes="Kuwantima Classic" IsChecked="{Binding IsOn}"/&gt;'/>
                    <CheckBox Classes="Kuwantima Classic" Content="Indeterminate" IsChecked="{x:Null}" IsThreeState="True"
                              ToolTip.Tip='&lt;CheckBox Classes="Kuwantima Classic" IsThreeState="True"/&gt;'/>
                    <CheckBox Classes="Kuwantima Classic" Content="Disabled" IsEnabled="False"
                              ToolTip.Tip='&lt;CheckBox Classes="Kuwantima Classic" IsEnabled="False"/&gt;'/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Horizontal arrow splitter -->
        <GridSplitter Classes="Kuwantima Arrow" Grid.Row="1"/>

        <!-- ═══ BOTTOM ROW ═══ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*">

            <!-- BOTTOM-LEFT: Radio Buttons -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Margin="16">
                    <TextBlock Text="Radio Buttons" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <RadioButton Classes="Kuwantima" Content="Option A" GroupName="Demo" IsChecked="True"
                                 ToolTip.Tip='&lt;RadioButton Classes="Kuwantima" GroupName="G1"/&gt;'/>
                    <RadioButton Classes="Kuwantima" Content="Option B" GroupName="Demo"
                                 ToolTip.Tip='&lt;RadioButton Classes="Kuwantima" GroupName="G1"/&gt;'/>
                    <RadioButton Classes="Kuwantima" Content="Option C" GroupName="Demo"
                                 ToolTip.Tip='&lt;RadioButton Classes="Kuwantima" GroupName="G1"/&gt;'/>
                    <RadioButton Classes="Kuwantima" Content="Disabled" GroupName="Demo" IsEnabled="False"
                                 ToolTip.Tip='&lt;RadioButton Classes="Kuwantima" IsEnabled="False"/&gt;'/>

                    <TextBlock Text="Classic Radio Buttons" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <RadioButton Classes="Kuwantima Classic" Content="Option A" GroupName="ClassicDemo" IsChecked="True"
                                 ToolTip.Tip='&lt;RadioButton Classes="Kuwantima Classic" GroupName="G1"/&gt;'/>
                    <RadioButton Classes="Kuwantima Classic" Content="Option B" GroupName="ClassicDemo"
                                 ToolTip.Tip='&lt;RadioButton Classes="Kuwantima Classic" GroupName="G1"/&gt;'/>
                    <RadioButton Classes="Kuwantima Classic" Content="Option C" GroupName="ClassicDemo"
                                 ToolTip.Tip='&lt;RadioButton Classes="Kuwantima Classic" GroupName="G1"/&gt;'/>
                    <RadioButton Classes="Kuwantima Classic" Content="Disabled" GroupName="ClassicDemo" IsEnabled="False"
                                 ToolTip.Tip='&lt;RadioButton Classes="Kuwantima Classic" IsEnabled="False"/&gt;'/>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom vertical arrow splitter -->
            <GridSplitter Classes="Kuwantima Arrow Vertical" Grid.Column="1"/>

            <!-- BOTTOM-RIGHT: Menu Toggle Buttons -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Margin="16">
                    <TextBlock Text="Menu Toggle Buttons" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <StackPanel Spacing="4">
                        <ToggleButton Classes="KuwantimaMenu Expanded"
                                      Tag="{StaticResource Icon.Expand}"
                                      Content="Expand" IsChecked="False"
                                      ToolTip.Tip='&lt;ToggleButton Classes="KuwantimaMenu Expanded" Tag="{StaticResource Icon.Expand}"/&gt;'/>
                        <ToggleButton Classes="KuwantimaMenu Expanded"
                                      Tag="{StaticResource Icon.Collapse}"
                                      Content="Collapse" IsChecked="True"
                                      ToolTip.Tip='&lt;ToggleButton Classes="KuwantimaMenu Expanded" Tag="{StaticResource Icon.Collapse}"/&gt;'/>
                        <ToggleButton Classes="KuwantimaMenu"
                                      Tag="{StaticResource Icon.Gear}"
                                      ToolTip.Tip='&lt;ToggleButton Classes="KuwantimaMenu" Tag="{StaticResource Icon.Gear}"/&gt;'/>
                        <ToggleButton Classes="KuwantimaMenu Expanded"
                                      Tag="{StaticResource Icon.Gear}"
                                      Content="Disabled" IsEnabled="False"
                                      ToolTip.Tip='&lt;ToggleButton Classes="KuwantimaMenu Expanded" IsEnabled="False"/&gt;'/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
    </Border>
</UserControl>
