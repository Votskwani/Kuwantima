<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kuwantima.Sandbox.ViewModels"
             x:Class="Kuwantima.Sandbox.Views.Pages.DocumentsPage"
             x:DataType="vm:MainWindowViewModel">

    <Border Classes="KuwantimaGlass" Padding="0" ClipToBounds="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="24" MaxWidth="700" Margin="0,0,0,24">

            <!-- Title + Version -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Kuwantima" FontWeight="Bold" FontSize="28"
                               Foreground="{DynamicResource SystemAccentColor}"/>
                    <TextBlock Text="{Binding KuwantimaVersion, StringFormat='v{0}'}"
                               FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
                <TextBlock Text="A glass-glow design system for Avalonia UI."
                           FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="One StyleInclude, 15 styled controls, automatic light/dark theming."
                           FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <!-- License button -->
            <Button Classes="Kuwantima" Content="View MIT License" Click="OnShowLicense"/>

            <!-- Features -->
            <StackPanel Spacing="8">
                <TextBlock Text="Features" FontWeight="SemiBold" FontSize="18"/>
                <StackPanel Spacing="4" Margin="12,0,0,0">
                    <TextBlock FontSize="13" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Glass morphism</Run>
                        <Run Text=" aesthetic with glow borders, frosted panels, and themed shadows"/>
                    </TextBlock>
                    <TextBlock FontSize="13" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Light &amp; Dark</Run>
                        <Run Text=" themes that swap automatically — MidnightBlue ink on light, AliceBlue frost on dark"/>
                    </TextBlock>
                    <TextBlock FontSize="13" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Fluent-integrated</Run>
                        <Run Text=" — extends Avalonia's FluentTheme palette so styled and unstyled controls stay harmonious"/>
                    </TextBlock>
                    <TextBlock FontSize="13" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Class-based</Run>
                        <Run Text=" — opt in per control with Classes=&quot;Kuwantima&quot;, no global override"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Quick Start -->
            <StackPanel Spacing="8">
                <TextBlock Text="Quick Start" FontWeight="SemiBold" FontSize="18"/>
                <TextBlock Text="Add a project reference, then in your App.axaml:" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Border Classes="KuwantimaGlass" Padding="12" CornerRadius="6">
                    <SelectableTextBlock FontFamily="Cascadia Code,Consolas,Courier New" FontSize="12"
                                         Foreground="{DynamicResource SystemAccentColor}"
                                         Text="&lt;StyleInclude Source=&quot;avares://Kuwantima/Theme/KuwantimaPrimaryTheme.axaml&quot;/&gt;"/>
                </Border>
                <TextBlock Text="Apply Kuwantima styling to individual controls:" FontSize="13" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Border Classes="KuwantimaGlass" Padding="12" CornerRadius="6">
                    <SelectableTextBlock FontFamily="Cascadia Code,Consolas,Courier New" FontSize="12" xml:space="preserve"
                                         Text="&lt;Button Classes=&quot;Kuwantima&quot; Content=&quot;Click me&quot;/&gt;&#x0a;&lt;CheckBox Classes=&quot;Kuwantima&quot; Content=&quot;Accept terms&quot;/&gt;&#x0a;&lt;TextBox Classes=&quot;Kuwantima&quot; PlaceholderText=&quot;Search...&quot;/&gt;"/>
                </Border>
            </StackPanel>

            <!-- Controls Table -->
            <StackPanel Spacing="8">
                <TextBlock Text="Controls" FontWeight="SemiBold" FontSize="18"/>
                <Border Classes="KuwantimaGlass" Padding="16" CornerRadius="6">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Control" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Class" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Variants" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Button" FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Accent" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="CheckBox" FontSize="12"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Classic" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ComboBox" FontSize="12"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Expander" FontSize="12"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Border (Glass)" FontSize="12"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="KuwantimaGlass" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="GridSplitter" FontSize="12"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Pill, Arrow" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="ListBox" FontSize="12"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="MenuToggleButton" FontSize="12"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="KuwantimaMenu" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="ProgressBar" FontSize="12"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="RadioButton" FontSize="12"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="Classic" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Slider" FontSize="12"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="TabControl" FontSize="12"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="13" Grid.Column="0" Text="TextBox" FontSize="12"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>
                        <TextBlock Grid.Row="13" Grid.Column="2" Text="ReadOnly" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="ToggleButton" FontSize="12"/>
                        <TextBlock Grid.Row="14" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>

                        <TextBlock Grid.Row="15" Grid.Column="0" Text="ToolTip" FontSize="12"/>
                        <TextBlock Grid.Row="15" Grid.Column="1" Text="Kuwantima" FontSize="11" FontFamily="Cascadia Code,Consolas,Courier New"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Theming -->
            <StackPanel Spacing="8">
                <TextBlock Text="Theming" FontWeight="SemiBold" FontSize="18"/>
                <TextBlock Text="Kuwantima's color story is built on three layers:" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <Border Classes="KuwantimaGlass" Padding="16" CornerRadius="6">
                    <StackPanel Spacing="10">
                        <!-- Cool anchor -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="24" Height="24" CornerRadius="4" Background="#191970"/>
                            <StackPanel>
                                <TextBlock Text="Cool Anchor" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="MidnightBlue / AliceBlue — tints all Fluent tokens" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Warm accent -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="24" Height="24" CornerRadius="4" Background="#FF8C00"/>
                            <StackPanel>
                                <TextBlock Text="Warm Accent" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Orange — checked/selected borders, contrasts against cool blue" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- System accent -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="24" Height="24" CornerRadius="4" Background="#0078D4"/>
                            <StackPanel>
                                <TextBlock Text="System Accent" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Fluent Blue — filled accent backgrounds (buttons, selections)" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Version History -->
            <StackPanel Spacing="8">
                <TextBlock Text="Version History" FontWeight="SemiBold" FontSize="18"/>
                <Border Classes="KuwantimaGlass" Padding="16" CornerRadius="6">
                    <StackPanel Spacing="12">
                        <!-- v1.1.0 -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                        CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="v1.1.0" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="2026-04-14" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="Avalonia 12 Upgrade" FontSize="12" VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Spacing="3" Margin="12,0,0,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Avalonia 11.3.11 → 12.0.1"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="CommunityToolkit.Mvvm 8.2.1 → 8.4.2"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="TextBox.Watermark → PlaceholderText (Avalonia 12 rename)"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Removed obsolete BindingPlugins workaround"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- v1.0.0 -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                        CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="v1.0.0" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="2025-03-11" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="Initial Release" FontSize="12" VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Spacing="3" Margin="12,0,0,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="15 styled controls with Kuwantima class-based styling"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Classic variants for CheckBox and RadioButton"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Accent variant for Button"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="GridSplitter variants: Pill, Arrow (horizontal + vertical)"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Full Fluent palette override (28 tokens, Light + Dark)"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Glass-glow border and shadow system"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Fluent brush integration (accent foreground, secondary/tertiary text)"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Tooltip, Splitter, and semantic status theme resources"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Requirements -->
            <StackPanel Spacing="8">
                <TextBlock Text="Requirements" FontWeight="SemiBold" FontSize="18"/>
                <StackPanel Spacing="4" Margin="12,0,0,0">
                    <TextBlock Text=".NET 10.0" FontSize="13"/>
                    <TextBlock Text="Avalonia 12.0+" FontSize="13"/>
                    <TextBlock Text="Avalonia.Themes.Fluent 12.0+" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <!-- License footer -->
            <StackPanel Spacing="4">
                <Separator Height="1" Background="{DynamicResource KuwantimaDarkBorderBrush}" Margin="0,8"/>
                <TextBlock Text="MIT License" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
    </Border>
</UserControl>
