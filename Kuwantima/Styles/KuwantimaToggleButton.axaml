<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<Grid ColumnDefinitions="*, *">
				<!-- LEFT SIDE: LIGHT THEME PREVIEW -->
				<ThemeVariantScope RequestedThemeVariant="Light" Grid.Column="0">
					<Panel Background="{DynamicResource SystemRegionBrush}">
						<StackPanel Spacing="20" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
							<TextBlock Text="Light Theme" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>

							<!-- Unchecked State -->
							<ToggleButton Classes="Kuwantima" Content="Unchecked" IsChecked="False"/>

							<!-- Checked State -->
							<ToggleButton Classes="Kuwantima" Content="Checked" IsChecked="True"/>

							<!-- Disabled State -->
							<ToggleButton Classes="Kuwantima" Content="Disabled" IsEnabled="False"/>
						</StackPanel>
					</Panel>
				</ThemeVariantScope>

				<!-- RIGHT SIDE: DARK THEME PREVIEW -->
				<ThemeVariantScope RequestedThemeVariant="Dark" Grid.Column="1">
					<Panel Background="{DynamicResource SystemRegionBrush}">
						<StackPanel Spacing="20" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
							<TextBlock Text="Dark Theme" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>

							<!-- Unchecked State -->
							<ToggleButton Classes="Kuwantima" Content="Unchecked" IsChecked="False"/>

							<!-- Checked State -->
							<ToggleButton Classes="Kuwantima" Content="Checked" IsChecked="True"/>

							<!-- Disabled State -->
							<ToggleButton Classes="Kuwantima" Content="Disabled" IsEnabled="False"/>
						</StackPanel>
					</Panel>
				</ThemeVariantScope>

				<!-- Vertical Divider -->
				<Separator Width="1" VerticalAlignment="Stretch" Background="{DynamicResource KuwantimaDarkBorderBrush}" Grid.ColumnSpan="2"/>
			</Grid>
		</Border>
	</Design.PreviewWith>

	<!-- Base Style for Kuwantima ToggleButtons -->
	<Style Selector="ToggleButton.Kuwantima">
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource KuwantimaGlassGlowBorder}"/>
		<Setter Property="BorderThickness" Value="1.5"/>
		<Setter Property="Padding" Value="12,8"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Panel>
					<ContentPresenter Name="PART_ContentPresenter"
									  TextElement.Foreground="{TemplateBinding Foreground}"
									  Background="{TemplateBinding Background}"
									  BorderBrush="{TemplateBinding BorderBrush}"
									  BorderThickness="{TemplateBinding BorderThickness}"
									  CornerRadius="{TemplateBinding CornerRadius}"
									  Padding="{TemplateBinding Padding}"
									  Content="{TemplateBinding Content}"
									  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

					<!-- Status indicator (top-left corner) -->
					<Border Name="StatusRing"
							Width="12" Height="12"
							Margin="2"
							HorizontalAlignment="Left"
							VerticalAlignment="Top"
							BorderThickness="1.5"
							BorderBrush="Transparent"
							CornerRadius="12"
							IsHitTestVisible="False">
						<Ellipse Name="StatusCircle"
								 Width="7" Height="7"
								 HorizontalAlignment="Center"
								 VerticalAlignment="Center"
								 Fill="{DynamicResource SystemControlBackgroundAccentBrush}"/>
					</Border>
				</Panel>
			</ControlTemplate>
		</Setter>

		<!-- 1. Hover -->
		<Style Selector="^:pointerover">
			<Setter Property="Background" Value="{DynamicResource KuwantimaControlHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource KuwantimaGlassGlowBorderHover}"/>
		</Style>

		<!-- 2. Checked -->
		<Style Selector="^:checked">
			<Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>

			<Style Selector="^ /template/ Border#StatusRing">
				<Setter Property="BorderBrush" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
			</Style>

			<Style Selector="^ /template/ Ellipse#StatusCircle">
				<Setter Property="Fill" Value="{DynamicResource AccentButtonForeground}"/>
			</Style>
		</Style>

		<!-- 3. Checked + Hover -->
		<Style Selector="^:checked:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3}"/>
		</Style>

		<!-- 4. Disabled: pin Background/Foreground to prevent Fluent's disabled brushes from double-dimming -->
		<Style Selector="^:disabled">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Opacity" Value="0.5"/>
			<Setter Property="Cursor" Value="Arrow"/>

			<Style Selector="^ /template/ Ellipse#StatusCircle">
				<Setter Property="Opacity" Value="0.3"/>
			</Style>
		</Style>
	</Style>
</Styles>
