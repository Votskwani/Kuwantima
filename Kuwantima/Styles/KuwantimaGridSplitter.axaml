<Styles xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20" Width="600" Height="400">
			<Grid ColumnDefinitions="*, *">
				<!-- LEFT SIDE: LIGHT THEME PREVIEW -->
				<ThemeVariantScope RequestedThemeVariant="Light" Grid.Column="0">
					<Border Background="{DynamicResource SystemRegionBrush}" Classes="KuwantimaGlass" Padding="0" ClipToBounds="True">
						<Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*">
							<TextBlock Text="Light Theme" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"
							           Grid.ColumnSpan="3" Margin="0,12,0,8"/>

							<!-- Vertical splitter demo -->
							<Border Grid.Row="1" Grid.Column="0" Padding="12">
								<TextBlock Text="Left Panel" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
							</Border>

							<GridSplitter Classes="Kuwantima" Grid.Row="1" Grid.Column="1"/>

							<Border Grid.Row="1" Grid.Column="2">
								<Grid RowDefinitions="*,Auto,*">
									<Border Padding="12">
										<TextBlock Text="Top Right" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
									</Border>

									<GridSplitter Classes="Kuwantima Horizontal" Grid.Row="1"/>

									<Border Grid.Row="2" Padding="12">
										<TextBlock Text="Bottom Right" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
									</Border>
								</Grid>
							</Border>
						</Grid>
					</Border>
				</ThemeVariantScope>

				<!-- RIGHT SIDE: DARK THEME PREVIEW -->
				<ThemeVariantScope RequestedThemeVariant="Dark" Grid.Column="1">
					<Border Background="{DynamicResource SystemRegionBrush}" Classes="KuwantimaGlass" Padding="0" ClipToBounds="True">
						<Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*">
							<TextBlock Text="Dark Theme" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"
							           Grid.ColumnSpan="3" Margin="0,12,0,8"/>

							<!-- Vertical splitter demo -->
							<Border Grid.Row="1" Grid.Column="0" Padding="12">
								<TextBlock Text="Left Panel" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
							</Border>

							<GridSplitter Classes="Kuwantima" Grid.Row="1" Grid.Column="1"/>

							<Border Grid.Row="1" Grid.Column="2">
								<Grid RowDefinitions="*,Auto,*">
									<Border Padding="12">
										<TextBlock Text="Top Right" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
									</Border>

									<GridSplitter Classes="Kuwantima Horizontal" Grid.Row="1"/>

									<Border Grid.Row="2" Padding="12">
										<TextBlock Text="Bottom Right" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
									</Border>
								</Grid>
							</Border>
						</Grid>
					</Border>
				</ThemeVariantScope>
			</Grid>
		</Border>
	</Design.PreviewWith>

	<!-- ═══ BASE: GridSplitter.Kuwantima (Vertical — between columns) ═══ -->
	<Style Selector="GridSplitter.Kuwantima">
		<Setter Property="Background" Value="{DynamicResource KuwantimaGlassGlowBorder}"/>
		<Setter Property="Width" Value="1.5"/>
		<Setter Property="MinWidth" Value="6"/>
		<Setter Property="Cursor" Value="SizeWestEast"/>
		<Setter Property="Margin" Value="0"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent">
					<!-- Thin visible line, centered in the hit-test area -->
					<Border Name="SplitterLine"
					        Background="{TemplateBinding Background}"
					        Width="1.5"
					        HorizontalAlignment="Center"
					        VerticalAlignment="Stretch"
					        CornerRadius="1">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.2"/>
							</Transitions>
						</Border.Transitions>
					</Border>
				</Border>
			</ControlTemplate>
		</Setter>

		<!-- Hover -->
		<Style Selector="^:pointerover /template/ Border#SplitterLine">
			<Setter Property="Background" Value="{DynamicResource KuwantimaGlassGlowBorderHover}"/>
			<Setter Property="Width" Value="2.5"/>
		</Style>

		<!-- Dragging -->
		<Style Selector="^:pressed /template/ Border#SplitterLine">
			<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
			<Setter Property="Width" Value="2.5"/>
		</Style>
	</Style>

	<!-- ═══ HORIZONTAL: GridSplitter.Kuwantima.Horizontal (between rows) ═══ -->
	<Style Selector="GridSplitter.Kuwantima.Horizontal">
		<Setter Property="Width" Value="NaN"/>
		<Setter Property="Height" Value="1.5"/>
		<Setter Property="MinHeight" Value="6"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="Cursor" Value="SizeNorthSouth"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent">
					<Border Name="SplitterLine"
					        Background="{TemplateBinding Background}"
					        Height="1.5"
					        VerticalAlignment="Center"
					        HorizontalAlignment="Stretch"
					        CornerRadius="1">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.2"/>
							</Transitions>
						</Border.Transitions>
					</Border>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Horizontal hover -->
	<Style Selector="GridSplitter.Kuwantima.Horizontal:pointerover /template/ Border#SplitterLine">
		<Setter Property="Background" Value="{DynamicResource KuwantimaGlassGlowBorderHover}"/>
		<Setter Property="Height" Value="2.5"/>
	</Style>

	<!-- Horizontal dragging -->
	<Style Selector="GridSplitter.Kuwantima.Horizontal:pressed /template/ Border#SplitterLine">
		<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
		<Setter Property="Height" Value="2.5"/>
	</Style>

	<!-- ═══ PILL: GridSplitter.Kuwantima.Pill (between glass panels — horizontal) ═══ -->
	<Style Selector="GridSplitter.Kuwantima.Pill">
		<Setter Property="Height" Value="8"/>
		<Setter Property="Width" Value="NaN"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="MinHeight" Value="0"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Cursor" Value="SizeNorthSouth"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}" Padding="0,2">
					<Border Name="PillHandle"
					        Height="3" Width="40" CornerRadius="2"
					        HorizontalAlignment="Center"
					        Background="{DynamicResource KuwantimaSplitterBrush}">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.2"/>
								<DoubleTransition Property="Width" Duration="0:0:0.15"/>
							</Transitions>
						</Border.Transitions>
					</Border>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="GridSplitter.Kuwantima.Pill:pointerover /template/ Border#PillHandle">
		<Setter Property="Background" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
		<Setter Property="Width" Value="60"/>
	</Style>

	<Style Selector="GridSplitter.Kuwantima.Pill:pressed /template/ Border#PillHandle">
		<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
		<Setter Property="Width" Value="60"/>
	</Style>

	<!-- ═══ PILL VERTICAL: GridSplitter.Kuwantima.Pill.Vertical ═══ -->
	<Style Selector="GridSplitter.Kuwantima.Pill.Vertical">
		<Setter Property="Height" Value="NaN"/>
		<Setter Property="Width" Value="8"/>
		<Setter Property="VerticalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="Cursor" Value="SizeWestEast"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}" Padding="0,2">
					<Border Name="PillHandle"
					        Width="3" Height="40" CornerRadius="2"
					        HorizontalAlignment="Center"
					        VerticalAlignment="Center"
					        Background="{DynamicResource KuwantimaSplitterBrush}">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.2"/>
								<DoubleTransition Property="Height" Duration="0:0:0.15"/>
							</Transitions>
						</Border.Transitions>
					</Border>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="GridSplitter.Kuwantima.Pill.Vertical:pointerover /template/ Border#PillHandle">
		<Setter Property="Background" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
		<Setter Property="Width" Value="3"/>
		<Setter Property="Height" Value="50"/>
	</Style>

	<Style Selector="GridSplitter.Kuwantima.Pill.Vertical:pressed /template/ Border#PillHandle">
		<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
		<Setter Property="Width" Value="3"/>
		<Setter Property="Height" Value="50"/>
	</Style>

	<!-- ═══ ARROW: GridSplitter.Kuwantima.Arrow (inside bordered container — horizontal) ═══ -->
	<!-- Two parallel rails with arrow ends merging into the container border, pill centered -->
	<Style Selector="GridSplitter.Kuwantima.Arrow">
		<Setter Property="Height" Value="8"/>
		<Setter Property="Width" Value="NaN"/>
		<Setter Property="MinHeight" Value="8"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Cursor" Value="SizeNorthSouth"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}">
					<Panel>
						<!-- Top rail — full width, inset for arrows -->
						<Border Name="RailTop" Height="1"
						        VerticalAlignment="Top" Margin="5,0"
						        Background="{DynamicResource KuwantimaSplitterBrush}"/>
						<!-- Bottom rail — full width, inset for arrows -->
						<Border Name="RailBottom" Height="1"
						        VerticalAlignment="Bottom" Margin="5,0"
						        Background="{DynamicResource KuwantimaSplitterBrush}"/>
						<!-- Left arrow ◁ connecting both rails to border -->
						<Path Name="ArrowLeft"
						      Data="M 5,0 L 0,4 L 5,8"
						      StrokeThickness="1"
						      Stroke="{DynamicResource KuwantimaSplitterBrush}"
						      HorizontalAlignment="Left"
						      VerticalAlignment="Center"
						      Stretch="Uniform" Width="5" Height="8"/>
						<!-- Right arrow ▷ connecting both rails to border -->
						<Path Name="ArrowRight"
						      Data="M 0,0 L 5,4 L 0,8"
						      StrokeThickness="1"
						      Stroke="{DynamicResource KuwantimaSplitterBrush}"
						      HorizontalAlignment="Right"
						      VerticalAlignment="Center"
						      Stretch="Uniform" Width="5" Height="8"/>
						<!-- Center pill handle -->
						<Border Name="ArrowPill"
						        Height="3" Width="40" CornerRadius="2"
						        HorizontalAlignment="Center"
						        VerticalAlignment="Center"
						        Background="{DynamicResource KuwantimaSplitterBrush}">
							<Border.Transitions>
								<Transitions>
									<DoubleTransition Property="Width" Duration="0:0:0.15"/>
								</Transitions>
							</Border.Transitions>
						</Border>
					</Panel>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Arrow horizontal hover -->
	<Style Selector="GridSplitter.Kuwantima.Arrow:pointerover /template/ Border#RailTop">
		<Setter Property="Background" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow:pointerover /template/ Border#RailBottom">
		<Setter Property="Background" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow:pointerover /template/ Path#ArrowLeft">
		<Setter Property="Stroke" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow:pointerover /template/ Path#ArrowRight">
		<Setter Property="Stroke" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow:pointerover /template/ Border#ArrowPill">
		<Setter Property="Background" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
		<Setter Property="Width" Value="60"/>
	</Style>

	<!-- Arrow horizontal pressed -->
	<Style Selector="GridSplitter.Kuwantima.Arrow:pressed /template/ Border#RailTop">
		<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow:pressed /template/ Border#RailBottom">
		<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow:pressed /template/ Path#ArrowLeft">
		<Setter Property="Stroke" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow:pressed /template/ Path#ArrowRight">
		<Setter Property="Stroke" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow:pressed /template/ Border#ArrowPill">
		<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
		<Setter Property="Width" Value="60"/>
	</Style>

	<!-- ═══ ARROW VERTICAL: GridSplitter.Kuwantima.Arrow.Vertical ═══ -->
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical">
		<Setter Property="Width" Value="8"/>
		<Setter Property="Height" Value="NaN"/>
		<Setter Property="MinWidth" Value="8"/>
		<Setter Property="MinHeight" Value="0"/>
		<Setter Property="VerticalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Cursor" Value="SizeWestEast"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}">
					<Panel>
						<!-- Left rail — full height, inset for arrows -->
						<Border Name="RailLeft" Width="1"
						        HorizontalAlignment="Left" Margin="0,5"
						        Background="{DynamicResource KuwantimaSplitterBrush}"/>
						<!-- Right rail — full height, inset for arrows -->
						<Border Name="RailRight" Width="1"
						        HorizontalAlignment="Right" Margin="0,5"
						        Background="{DynamicResource KuwantimaSplitterBrush}"/>
						<!-- Top arrow △ connecting both rails to border -->
						<Path Name="ArrowTop"
						      Data="M 0,5 L 4,0 L 8,5"
						      StrokeThickness="1"
						      Stroke="{DynamicResource KuwantimaSplitterBrush}"
						      VerticalAlignment="Top"
						      HorizontalAlignment="Center"
						      Stretch="Uniform" Width="8" Height="5"/>
						<!-- Bottom arrow ▽ connecting both rails to border -->
						<Path Name="ArrowBottom"
						      Data="M 0,0 L 4,5 L 8,0"
						      StrokeThickness="1"
						      Stroke="{DynamicResource KuwantimaSplitterBrush}"
						      VerticalAlignment="Bottom"
						      HorizontalAlignment="Center"
						      Stretch="Uniform" Width="8" Height="5"/>
						<!-- Center pill handle -->
						<Border Name="ArrowPill"
						        Width="3" Height="40" CornerRadius="2"
						        HorizontalAlignment="Center"
						        VerticalAlignment="Center"
						        Background="{DynamicResource KuwantimaSplitterBrush}">
							<Border.Transitions>
								<Transitions>
									<DoubleTransition Property="Height" Duration="0:0:0.15"/>
								</Transitions>
							</Border.Transitions>
						</Border>
					</Panel>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Arrow vertical hover -->
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical:pointerover /template/ Border#RailLeft">
		<Setter Property="Background" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical:pointerover /template/ Border#RailRight">
		<Setter Property="Background" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical:pointerover /template/ Path#ArrowTop">
		<Setter Property="Stroke" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical:pointerover /template/ Path#ArrowBottom">
		<Setter Property="Stroke" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical:pointerover /template/ Border#ArrowPill">
		<Setter Property="Background" Value="{DynamicResource KuwantimaSplitterHoverBrush}"/>
		<Setter Property="Width" Value="3"/>
		<Setter Property="Height" Value="50"/>
	</Style>

	<!-- Arrow vertical pressed -->
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical:pressed /template/ Border#RailLeft">
		<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical:pressed /template/ Border#RailRight">
		<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical:pressed /template/ Path#ArrowTop">
		<Setter Property="Stroke" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical:pressed /template/ Path#ArrowBottom">
		<Setter Property="Stroke" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
	</Style>
	<Style Selector="GridSplitter.Kuwantima.Arrow.Vertical:pressed /template/ Border#ArrowPill">
		<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
		<Setter Property="Width" Value="3"/>
		<Setter Property="Height" Value="50"/>
	</Style>

	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<!-- DISABLED — one selector, every variant                                  -->
	<!--                                                                          -->
	<!-- Declared LAST on purpose. Avalonia resolves competing setters by         -->
	<!-- document order, not selector specificity, so this single selector wins   -->
	<!-- over the resize cursor that all six variant base styles set above.       -->
	<!-- Verified against a live control by                                       -->
	<!-- InvariantTests.Disabled_splitter_drops_its_resize_cursor_and_dims —      -->
	<!-- move this block higher up the file and that test goes red.               -->
	<!--                                                                          -->
	<!-- Opacity is doing the real work. A splitter has no label, glyph or        -->
	<!-- content — the cursor and the dimming ARE its whole affordance — so       -->
	<!-- without this, a disabled splitter is indistinguishable from a live one   -->
	<!-- that simply is not being hovered.                                        -->
	<!--                                                                          -->
	<!-- No Foreground pin: nothing renders through Foreground here (rails, pill  -->
	<!-- and chevrons are Background/Stroke), so there is no text for Fluent to   -->
	<!-- dim on top of ours. The hover and press glow needs no neutralising       -->
	<!-- either — Avalonia does not set :pointerover on a disabled control        -->
	<!-- (unlike WPF's IsMouseOver), so those ~30 selectors never fire.           -->
	<!-- ═══════════════════════════════════════════════════════════════════════ -->
	<Style Selector="GridSplitter.Kuwantima:disabled">
		<Setter Property="Opacity" Value="0.5"/>
		<Setter Property="Cursor" Value="Arrow"/>
	</Style>
</Styles>
