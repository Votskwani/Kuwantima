<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					mc:Ignorable="d">

	<Design.PreviewWith>
		<ScrollViewer HorizontalScrollBarVisibility="Auto">
			<!-- PREVIEW ONLY. At runtime the consumer's StyleInclude supplies these; here the
			     file stands alone, and an unresolvable DynamicResource is SILENT, so without
			     them every brush setter below is skipped and the preview renders bare. Do NOT
			     swap in KuwantimaPrimaryTheme: it carries the SHIPPED control styles and would
			     show you those instead of the edit you are making in this file. -->
			<ScrollViewer.Styles>
				<FluentTheme/>
			</ScrollViewer.Styles>
			<ScrollViewer.Resources>
				<ResourceDictionary>
					<ResourceDictionary.MergedDictionaries>
						<ResourceInclude Source="avares://Kuwantima/Theme/KuwantimaThemeResources.axaml"/>
					</ResourceDictionary.MergedDictionaries>
				</ResourceDictionary>
			</ScrollViewer.Resources>
			<!-- Neutral backdrop to make both themes pop -->
			<Border Padding="30" Background="#808080">
				<StackPanel Orientation="Horizontal" Spacing="40">

					<!-- LIGHT SIDE -->
					<ThemeVariantScope RequestedThemeVariant="Light">
						<Border Padding="20" MinWidth="300" CornerRadius="8"
								Background="{DynamicResource SystemRegionBrush}"
								BoxShadow="0 4 10 0 #40000000">
							<StackPanel Spacing="15">
								<TextBlock Text="SideMenu Icons (Light)" FontWeight="Bold" Foreground="{DynamicResource SystemBaseHighColor}"/>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Home}" Foreground="{DynamicResource SystemAccentColor}"/>
									<TextBlock Text="Home" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Gear}" Foreground="{DynamicResource SystemAccentColor}"/>
									<TextBlock Text="Settings" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Sliders}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Configuration" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Expand}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Expand" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Collapse}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Collapse" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Sun}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Sun" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Moon.ThirdEye.Smiling}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Moon" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Search}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Search" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Clear.Circle}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Clear" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Layers}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Layers" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

							</StackPanel>
						</Border>
					</ThemeVariantScope>

					<!-- DARK SIDE -->
					<ThemeVariantScope RequestedThemeVariant="Dark">
						<Border Padding="20" MinWidth="300" CornerRadius="8"
								Background="{DynamicResource SystemRegionBrush}"
								BoxShadow="0 4 10 0 #40000000">
							<StackPanel Spacing="15">
								<TextBlock Text="SideMenu Icons (Dark)" FontWeight="Bold" Foreground="{DynamicResource SystemBaseHighColor}"/>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Home}" Foreground="{DynamicResource SystemAccentColor}"/>
									<TextBlock Text="Home" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Gear}" Foreground="{DynamicResource SystemAccentColor}"/>
									<TextBlock Text="Settings" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Sliders}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Configuration" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Expand}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Expand" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Collapse}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Collapse" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Sun}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Sun" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Moon.ThirdEye.Smiling}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Moon" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Search}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Search" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Clear.Circle}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Clear" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="10">
									<PathIcon Data="{StaticResource Icon.Layers}" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
									<TextBlock Text="Layers" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseHighColor}"/>
								</StackPanel>

							</StackPanel>
						</Border>
					</ThemeVariantScope>

				</StackPanel>
			</Border>
		</ScrollViewer>
	</Design.PreviewWith>

	<!-- Navigation -->
	<StreamGeometry x:Key="Icon.Home">
		M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z
	</StreamGeometry>

