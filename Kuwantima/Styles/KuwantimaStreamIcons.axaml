	</StreamGeometry>

	<!-- Configuration -->
	<StreamGeometry x:Key="Icon.Sliders">
		M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z
	</StreamGeometry>

	<!-- Layout -->
	<StreamGeometry x:Key="Icon.Expand">
		M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z
	</StreamGeometry>

	<StreamGeometry x:Key="Icon.Collapse">
		M4,2H20A2,2 0 0,1 22,4V20A2,2 0 0,1 20,22H4A2,2 0 0,1 2,20V4A2,2 0 0,1 4,2M4,4V20H10V4H4M12,4V20H20V4H12M18,12L14,8V11H12V13H14V16L18,12Z
