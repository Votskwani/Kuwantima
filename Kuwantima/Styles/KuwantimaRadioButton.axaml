<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<Grid ColumnDefinitions="*, *">
				<!-- LEFT SIDE: LIGHT THEME PREVIEW -->
				<ThemeVariantScope RequestedThemeVariant="Light" Grid.Column="0">
					<Panel Background="{DynamicResource SystemRegionBrush}">
						<StackPanel Spacing="20" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
							<TextBlock Text="Light Theme" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>

							<!-- Unchecked State -->
							<RadioButton Classes="Kuwantima" Content="Standard Mode" IsChecked="False"/>

							<!-- Checked (Accent) State -->
							<RadioButton Classes="Kuwantima" Content="Accent Mode" IsChecked="True"/>

							<!-- Disabled State -->
							<RadioButton Classes="Kuwantima" Content="Disabled Mode" IsEnabled="False"/>
							<Separator Height="1" Margin="0,8" Background="{DynamicResource KuwantimaDarkBorderBrush}"/>
							<TextBlock Text="Classic Variant" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>

							<RadioButton Classes="Kuwantima Classic" Content="Standard Mode" IsChecked="False"/>

							<RadioButton Classes="Kuwantima Classic" Content="Accent Mode" IsChecked="True"/>

							<RadioButton Classes="Kuwantima Classic" Content="Disabled Mode" IsEnabled="False"/>
						</StackPanel>
					</Panel>
				</ThemeVariantScope>

				<!-- RIGHT SIDE: DARK THEME PREVIEW -->
				<ThemeVariantScope RequestedThemeVariant="Dark" Grid.Column="1">
					<Panel Background="{DynamicResource SystemRegionBrush}">
						<StackPanel Spacing="20" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
							<TextBlock Text="Dark Theme" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>

							<!-- Unchecked State -->
							<RadioButton Classes="Kuwantima" Content="Button 1" IsChecked="False"/>

							<!-- Checked (Accent) State -->
							<RadioButton Classes="Kuwantima" Content="Button 2" IsChecked="True"/>

							<!-- Disabled State -->
							<RadioButton Classes="Kuwantima" Content="Disabled Mode" IsEnabled="False"/>
							<Separator Height="1" Margin="0,8" Background="{DynamicResource KuwantimaDarkBorderBrush}"/>
							<TextBlock Text="Classic Variant" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>

							<RadioButton Classes="Kuwantima Classic" Content="Button 1" IsChecked="False"/>

							<RadioButton Classes="Kuwantima Classic" Content="Button 2" IsChecked="True"/>

							<RadioButton Classes="Kuwantima Classic" Content="Disabled Mode" IsEnabled="False"/>
						</StackPanel>
					</Panel>
				</ThemeVariantScope>

				<!-- Optional Vertical Divider -->
				<Separator Width="1" VerticalAlignment="Stretch" Background="{DynamicResource KuwantimaDarkBorderBrush}" Grid.ColumnSpan="2"/>
			</Grid>
		</Border>
	</Design.PreviewWith>

	<!-- Base Style for Kuwantima RadioButtons -->
	<Style Selector="RadioButton.Kuwantima">
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource KuwantimaGlassGlowBorder}"/>
		<Setter Property="BorderThickness" Value="1.5"/>
		<Setter Property="Padding" Value="12,8"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Panel>
					<ContentPresenter Name="PART_ContentPresenter"
									  TextElement.Foreground="{TemplateBinding Foreground}"
									  Background="{TemplateBinding Background}"
									  BorderBrush="{TemplateBinding BorderBrush}"
									  BorderThickness="{TemplateBinding BorderThickness}"
									  CornerRadius="{TemplateBinding CornerRadius}"
									  Padding="{TemplateBinding Padding}"
									  Content="{TemplateBinding Content}"
									  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

					<!-- Status indicator (top-left corner) -->
					<Border Name="StatusRing"
							Width="12" Height="12"
							Margin="2"
							HorizontalAlignment="Left"
							VerticalAlignment="Top"
							BorderThickness="1.5"
							BorderBrush="Transparent"
							CornerRadius="12"
							IsHitTestVisible="False">
						<Ellipse Name="StatusCircle"
								 Width="7" Height="7"
								 HorizontalAlignment="Center"
								 VerticalAlignment="Center"
								 Fill="{DynamicResource SystemControlBackgroundAccentBrush}"/>
					</Border>
				</Panel>
			</ControlTemplate>
		</Setter>

		<!-- 1. Hover -->
		<Style Selector="^:pointerover">
			<Setter Property="Background" Value="{DynamicResource KuwantimaControlHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource KuwantimaGlassGlowBorderHover}"/>
		</Style>

		<!-- 2. Checked -->
		<Style Selector="^:checked">
			<Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>

			<Style Selector="^ /template/ Border#StatusRing">
				<Setter Property="BorderBrush" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
			</Style>

			<Style Selector="^ /template/ Ellipse#StatusCircle">
				<Setter Property="Fill" Value="{DynamicResource AccentButtonForeground}"/>
			</Style>
		</Style>

		<!-- 3. Checked + Hover -->
		<Style Selector="^:checked:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3}"/>
		</Style>

		<!-- 4. Disabled: pin Background/Foreground to prevent Fluent's disabled brushes from double-dimming -->
		<Style Selector="^:disabled">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Opacity" Value="0.5"/>
			<Setter Property="Cursor" Value="Arrow"/>

			<Style Selector="^ /template/ Ellipse#StatusCircle">
				<Setter Property="Opacity" Value="0.3"/>
			</Style>
		</Style>
	</Style>

	<!-- ═══ Classic Variant: traditional radio button with circle on left ═══ -->
	<Style Selector="RadioButton.Kuwantima.Classic">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="CornerRadius" Value="0"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="Cursor" Value="Hand"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent" Padding="4,6">
					<Grid ColumnDefinitions="Auto,8,*">
						<!-- Radio circle -->
						<Border Name="RadioBorder"
								Grid.Column="0"
								Width="18" Height="18"
								VerticalAlignment="Center"
								BorderThickness="1.5"
								BorderBrush="{DynamicResource KuwantimaGlassGlowBorder}"
								CornerRadius="9"
								Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
							<!-- Inner dot -->
							<Ellipse Name="RadioDot"
									 Width="8" Height="8"
									 HorizontalAlignment="Center"
									 VerticalAlignment="Center"
									 Fill="{DynamicResource SystemControlBackgroundAccentBrush}"
									 Opacity="0"/>
						</Border>
						<!-- Label -->
						<ContentPresenter Name="PART_ContentPresenter"
										  Grid.Column="2"
										  TextElement.Foreground="{TemplateBinding Foreground}"
										  Content="{TemplateBinding Content}"
										  VerticalAlignment="Center"/>
					</Grid>
				</Border>
			</ControlTemplate>
		</Setter>

		<!-- Hover -->
		<Style Selector="^:pointerover">
			<Style Selector="^ /template/ Border#RadioBorder">
				<Setter Property="BorderBrush" Value="{DynamicResource KuwantimaGlassGlowBorderHover}"/>
				<Setter Property="Background" Value="{DynamicResource KuwantimaControlHoverBrush}"/>
			</Style>
		</Style>

		<!-- Checked: pin foreground back (base Kuwantima sets it to White) -->
		<Style Selector="^:checked">
			<Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}"/>
			<Style Selector="^ /template/ Border#RadioBorder">
				<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
			</Style>
			<Style Selector="^ /template/ Ellipse#RadioDot">
				<Setter Property="Fill" Value="{DynamicResource AccentButtonForeground}"/>
				<Setter Property="Opacity" Value="1"/>
			</Style>
		</Style>

		<!-- Checked + Hover -->
		<Style Selector="^:checked:pointerover">
			<Style Selector="^ /template/ Border#RadioBorder">
				<Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3}"/>
			</Style>
		</Style>

		<!-- Disabled -->
		<Style Selector="^:disabled">
			<Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}"/>
			<Setter Property="Opacity" Value="0.5"/>
			<Setter Property="Cursor" Value="Arrow"/>

			<Style Selector="^ /template/ Border#RadioBorder">
				<Setter Property="BorderBrush" Value="Transparent"/>
			</Style>
			<Style Selector="^ /template/ Ellipse#RadioDot">
				<Setter Property="Opacity" Value="0.3"/>
			</Style>
		</Style>
	</Style>
</Styles>
