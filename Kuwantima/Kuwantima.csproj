<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- PREVIEWER SUPPORT. These two look like noise on a resource-only library and are not.
         Avalonia's previewer runs "dotnet exec" against this assembly, passing its
         runtimeconfig.json and deps.json, to host Avalonia.Designer.HostApp.dll (see
         AvaloniaBuildTasks.targets, target AvaloniaFilePreview). A class library emits neither a
         runtimeconfig nor its dependencies into bin/, so there is nothing to exec and the IDE
         reports "no previewer available" for every file in this project. These make the library
         locally runnable WITHOUT making it an executable.

         Debug-only, and that condition is load-bearing rather than tidy: when
         GenerateRuntimeConfigurationFiles is on, NuGet packs the resulting
         Kuwantima.runtimeconfig.json into lib/net10.0/ alongside the DLL. Verified by packing both
         ways and diffing the .nupkg. The release path is Release (CLAUDE.md, and publish.yml packs
         with -c Release), so scoping these to Debug keeps the package byte-for-byte what it was
         while the previewer still gets what it needs. CopyLocalLockFileAssemblies never affects the
         package, but is scoped alongside it since it exists for the same reason. -->
    <GenerateRuntimeConfigurationFiles Condition="'$(Configuration)' == 'Debug'">true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies Condition="'$(Configuration)' == 'Debug'">true</CopyLocalLockFileAssemblies>

    <!-- The decisive one. The designer host execs the assembly holding the compiled XAML and asks
         it for an AppBuilder; a library has no entry point, so it fails with "Assembly ... doesn't
         have an entry point" and the IDE says "no previewer available" for EVERY file here.
         Debug becomes an exe purely to satisfy that. Release stays a library, so the package is
         untouched — verified by packing both ways and diffing the .nupkg. -->
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>

    <!-- NuGet package metadata -->
    <PackageId>Kuwantima</PackageId>
    <Version>1.5.0</Version>
    <Authors>Cole Larson</Authors>
    <Description>A glass-glow design system for Avalonia UI. 15 styled controls, automatic light/dark theming, Fluent palette integration.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Votskwani/Kuwantima</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Votskwani/Kuwantima</RepositoryUrl>
    <PackageTags>avalonia;ui;theme;glass;design-system</PackageTags>
    <!-- Version-coupled: rewrite this every release. It is on the Version Bump Checklist in
         CLAUDE.md for that reason - stale release notes are worse than none. -->
    <PackageReleaseNotes>v1.5.0 - New: a blocking-overlay scrim.

KuwantimaScrimBackground and KuwantimaScrimForeground - a wash plus ink for a blocking overlay over a long-running operation (a device probe, a save, any multi-step sequence). Additive and non-breaking: two new resource keys, defined in both Light and Dark, nothing existing renamed or removed.

Composited fresh from each theme's own anchor rather than borrowed from elsewhere - MidnightBlue in Light, AliceBlue in Dark - so the scrim reads as the same design language as the glass it sits over. Measured under both variants and both realistic backdrops (bare page, and page-under-a-glass-panel): worst case 7.25:1, comfortably above WCAG AA, and now enforced by Invariant_6 the same way the accent-ink pairs are.

Demoed on the Feedback sandbox page ("Show Blocking Overlay").</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- DO NOT re-add <AvaloniaResource Include="Styles\**\*.axaml" /> here.
         Avalonia's own props already include every **\*.axaml as AvaloniaXaml with
         SubType="Designer" (AvaloniaBuildTasks.props, gated only on EnableDefaultItems, which is on
         by default). Listing them AGAIN as AvaloniaResource gave every style file the build action
         "AvaloniaResource", which carries no Designer subtype — so Visual Studio refused to preview
         any of them and reported the build action as wrong. The explicit includes were redundant
         as well as harmful: AddAvaloniaResources fires when EITHER item type has entries, so the
         avares:// URIs this package's whole public API depends on come from the AvaloniaXaml items
         either way. Verified by the suite, which loads the theme through its avares StyleInclude. -->

    <!-- Previewer\ holds the ONLY C# in this library, and it never ships. Removing it in Release
         keeps the packaged assembly exactly what it has always been: compiled XAML and nothing
         else. If you are checking the "no C#" claim in CLAUDE.md, this is the exception and it is
         confined to Debug. -->
    <Compile Remove="Previewer\**\*.cs" Condition="'$(Configuration)' != 'Debug'" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />

    <!-- Previewer only. The designer host needs a windowing backend to render into; without it
         there is no platform and the preview cannot start. PrivateAssets="all" keeps it out of the
         .nupkg entirely — a consumer picking up a desktop backend from a styles package would be a
         real dependency regression, so the pack output is checked (see CLAUDE.md). -->
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
