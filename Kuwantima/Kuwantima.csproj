<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>Kuwantima</PackageId>
    <Version>1.1.0</Version>
    <Authors>Cole Larson</Authors>
    <Description>A glass-glow design system for Avalonia UI. 15 styled controls, automatic light/dark theming, Fluent palette integration.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Votskwani/Kuwantima</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Votskwani/Kuwantima</RepositoryUrl>
    <PackageTags>avalonia;ui;theme;glass;design-system</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Styles\**\*.axaml" />
    <AvaloniaResource Include="Theme\**\*.axaml" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
  </ItemGroup>

</Project>
