<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Keep these in lockstep with Kuwantima.csproj. A version skew here would
       test a different Avalonia than the one the library ships against. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.0" />
  </ItemGroup>

  <!-- xunit v3, not v2: Avalonia.Headless.XUnit 12.x is built against v3 and pulls
       xunit.v3.extensibility.core transitively. Keeping the v2 `xunit` package that
       `dotnet new xunit` scaffolds makes MemberDataAttribute ambiguous (CS0433). -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kuwantima\Kuwantima.csproj" />
  </ItemGroup>

  <!-- Avalonia's XAML compiler turns .axaml into IL and strips the raw markup: the built
       Kuwantima assembly exposes exactly one avares asset (!AvaloniaResourceXamlInfo), so
       the dictionary cannot be read back at runtime. Link the source file in instead — the
       test then reads the real dictionary and picks up new keys with no edit here. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Kuwantima\Theme\KuwantimaThemeResources.axaml"
                      LogicalName="KuwantimaThemeResources.axaml" />
  </ItemGroup>

  <!-- Tier 2 (InvariantTests) parses the shipped style files themselves, for the same reason:
       the markup does not survive into the assembly, so the source has to be linked in.

       The wildcard is deliberate. A new Kuwantima{Control}.axaml is embedded — and therefore
       swept into every invariant Theory — the moment it is created. It cannot quietly skip the
       suite, and InvariantTests.Every_style_file_is_classified fails until someone states, in
       code, whether the new control is interactive and whether it needs a disabled pin. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Kuwantima\Styles\*.axaml"
                      LogicalName="Styles/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Kuwantima\Theme\KuwantimaPrimaryTheme.axaml"
                      LogicalName="Theme/KuwantimaPrimaryTheme.axaml" />

    <!-- The two places outside the theme that publish a control count. Both are checked against
         the number of style files that actually exist. -->
    <EmbeddedResource Include="..\README.md" LogicalName="README.md" />
    <EmbeddedResource Include="..\Kuwantima\Kuwantima.csproj" LogicalName="Kuwantima.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
